# frozen_string_literal: true

require_relative 'boot'

# Tasks read components, which are built when a process starts. Building
# doesn't start anything: no pubsub, no workers.
#
# Migrations are bin/sid's: `bin/sid db migrations run`, and
# `bin/sid db migrations add <name>` for a new one.
Sidereal.config.build!

namespace :db do
  desc 'Wipe all events from the Sourced store and all projection rows'
  task :reset do
    Sourced.store.clear!
    Sourced.store.db[:campaigns].delete
    puts 'All events and projections deleted.'
  end
end
