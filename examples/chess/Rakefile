# frozen_string_literal: true

require_relative 'boot'

# Tasks read components, which are built when a process starts. Building
# doesn't start anything: no pubsub, no workers.
#
# Migrations are bin/sid's: `bin/sid db migrations run`.
Sidereal.config.build!

namespace :db do
  desc 'Wipe all events from the Sourced store'
  task :reset do
    Sourced.store.clear!
    puts 'All events deleted.'
  end
end
