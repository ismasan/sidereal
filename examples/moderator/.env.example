# Copy to .env and edit. Every value here is optional — with no .env at all the
# app falls back to these same defaults. A real environment variable always
# wins over the file.

# Web server (read by falcon.rb in the controller process)
HOST=localhost
PORT=9297
# Worker processes. Needs > 1 to exercise the cross-process pubsub, which is
# what lets two moderators on different workers see each other's moves.
COUNT=3

# SQLite event store, relative to the app directory
DATABASE_PATH=storage/moderator.db

# Cookie signing secret. Rack wants at least 64 bytes; generate one with
#   ruby -rsecurerandom -e 'puts SecureRandom.hex(64)'
# Change it and existing sessions stop validating, which here just means
# visitors get a new commenter id.
SESSION_SECRET=replace-me-run-ruby--rsecurerandom--e-putsSecureRandomhex64--and-paste-it-here

# Fixture file loaded by `rake db:seed`
FIXTURES=config/fixtures.yml
