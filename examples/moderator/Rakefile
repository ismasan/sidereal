# frozen_string_literal: true

require_relative 'boot'
require 'sequel/core'
require 'yaml'
Sequel.extension :migration

FIXTURES_PATH = ENV.fetch('FIXTURES', 'config/fixtures.yml')

namespace :db do
  desc 'Run database migrations'
  task :migrate do
    Sequel::Migrator.run(Sourced.store.db, 'db/migrations')
    puts 'Migrations complete.'
  end

  desc 'Generate the Sourced migration file into db/migrations'
  task :sourced_migration do
    Sourced.store.copy_migration_to do
      "db/migrations/#{Time.now.strftime('%Y%m%d%H%M%S')}_create_sourced_tables.rb"
    end
    puts 'Sourced migration file created in db/migrations/'
  end

  desc 'Wipe all events from the Sourced store and all projection rows'
  task :reset do
    Sourced.store.clear!
    Sourced.store.db[:comments].delete
    puts 'All events and projections deleted.'
  end

  # Appends the commands to the store; it does not run them. The decider and
  # projector consume them from a worker, so run this against a live server to
  # watch the board fill, or before booting one and they are picked up on
  # startup. Override the file with FIXTURES=path/to/other.yml
  desc "Dispatch the commands in #{FIXTURES_PATH} (comments land in the inbox)"
  task :seed do
    entries = YAML.load_file(FIXTURES_PATH)

    commands = entries.map.with_index(1) do |entry, line|
      type = entry['type'] or raise "entry #{line} in #{FIXTURES_PATH} has no 'type'"
      payload = (entry['payload'] || {}).transform_keys(&:to_sym)
      # Raises Sourced::Message::UnknownMessageError for a type no message
      # class registers, and Plumb::ParseError for a payload that fails its
      # schema — both before anything is appended.
      Sourced::Message.from(type:, payload:)
    end

    commands.each { |cmd| Sidereal.dispatch!(cmd) }

    puts "Dispatched #{commands.length} commands from #{FIXTURES_PATH}."
    puts 'Start the server (bundle exec falcon host) to see them processed.'
  end
end

# boot.rb is already loaded at the top of this file, so the session comes up
# with the domain (Comment, CommentsProjector, Subjects) and a configured
# Sourced store. The UI (app.rb, the pages) is not loaded — require it from
# the prompt if you want it.
desc 'Start an IRB session with boot.rb loaded'
task :console do
  require 'irb'

  puts <<~BANNER
    Moderator console — store: #{DB_PATH}
      Subjects.all                               # the things people comment on
      CommentsProjector.board_for(Subjects.first.id)
      Sidereal.dispatch!(Comment::CreateComment.new(payload: { ... }))
  BANNER

  # IRB parses ARGV itself, and rake's own arguments are still in there.
  ARGV.clear
  IRB.start
end
