#!/usr/bin/env ruby
# frozen_string_literal: true

# This app's `sid`: Sidereal's command line, running with this app's gems,
# plus commands that only work inside an app, such as `bin/sid console`.
# Run `bin/sid --help` to list them.

ENV['BUNDLE_GEMFILE'] ||= File.expand_path('../Gemfile', __dir__)
require 'bundler/setup'
require 'sidereal/cli'

Sidereal::CLI.load_app(File.expand_path('..', __dir__))

exit Sidereal::CLI::Application.call(ARGV)
