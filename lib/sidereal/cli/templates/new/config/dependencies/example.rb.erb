# frozen_string_literal: true

# boot.rb loads every file in config/dependencies/. Each registers named
# dependencies with Sidereal.dependencies: the connections, clients and other
# services the app's classes use. Uncomment and adapt, or delete this file.
#
# Put requires at the top of the file, outside the blocks.
#
#   require 'net/http'

# A singleton, built once per process when it starts, before it serves
# anything. `teardown` releases it when the process stops.
#
#   Sidereal.dependencies.register!('mailer') do
#     Mailer.new(api_key: ENV.fetch('MAILER_API_KEY'))
#   end.teardown do |mailer|
#     mailer.close
#   end

# One built from others: list their keys, and the block gets their values in
# that order. Registrations can come in any order, in any file.
#
#   Sidereal.dependencies.register!('notifier', ['mailer']) do |mailer|
#     Notifier.new(mailer)
#   end

# `register`, without the `!`, builds a new value every time it's asked for.
#
#   Sidereal.dependencies.register('clock') { Time.now }

# Replace a dependency registered elsewhere, such as one of Sidereal's own
# ('sidereal.store', 'sidereal.pubsub', 'sidereal.elector'), with
# `override: true`.
#
#   Sidereal.dependencies.register!('sidereal.store', override: true) do
#     MyStore.new
#   end
<% if sourced? -%>

# A database connection for your own read models, which Sourced can store its
# events in too: register it here, then configure Sourced in boot.rb with
# `store: 'db'` in place of the lambda.
#
#   require 'sequel'
#
#   Sidereal.dependencies.register!('db') do
#     Sequel.sqlite(File.expand_path('../../storage/<%= app_name %>.db', __dir__))
#   end.teardown do |db|
#     db.disconnect
#   end
<% end -%>

# Classes ask for dependencies by name with `dep`, and get a reader for each.
# In web/app.rb, the readers work in `command` and `handle` blocks:
#
#   class App < Sidereal::App
#     dep :mailer
#
#     command SendWelcome do |cmd|
#       mailer.deliver(to: cmd.payload.email)
#     end
#   end
#
# Sidereal::Commander subclasses<% if sourced? %>, and Sourced deciders and projectors,<% end %> take `dep` too.
